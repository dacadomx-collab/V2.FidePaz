# Copiar a ".env" (NUNCA subir .env real a git). Permisos recomendados: 600.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fidepaz_v2_db
DB_USER=fidepaz_v2_user
DB_PASS=CAMBIA_ESTA_CONTRASEÑA_POR_UNA_FUERTE

# Generar con: openssl rand -hex 32   (o cualquier generador de 64 hex chars)
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_64_HEX_CHARS_ALEATORIOS

CORS_ALLOWED_ORIGINS=https://administrator.fidepaz.org,http://localhost:4200

PORT=8080
GIN_MODE=release
# APP_ENV: usado solo por GET /api/v2 (health check) para reportar el entorno actual.
# development | staging | production — no afecta lógica de negocio.
APP_ENV=development
# STATIC_DIR=../administrator   # solo si el binario sirve el frontend directamente
