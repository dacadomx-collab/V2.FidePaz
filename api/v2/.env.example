# Copiar a ".env" (NUNCA subir .env real a git ni al servidor sin permisos 600)
DB_HOST=localhost
DB_NAME=fidepaz_v2_db
DB_USER=fidepaz_v2_user
DB_PASS=CAMBIA_ESTA_CONTRASEÑA_POR_UNA_FUERTE
DB_CHARSET=utf8mb4

# Secreto HS256 para firmar JWT. Generar uno nuevo con:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_64_HEX_CHARS_ALEATORIOS
JWT_TTL_SECONDS=3600

# Orígenes permitidos por CORS, separados por coma. Nunca usar "*" con credenciales.
CORS_ALLOWED_ORIGINS=https://v2.fidepaz.org,http://localhost:4200

# APP_DEBUG=true expone mensaje/archivo/línea reales de excepciones en el JSON
# de error -- úsalo solo mientras diagnosticas y apágalo después.
APP_DEBUG=false

# SMTP (2026-08-10, Propuesta de valor #2 -- recuperación de contraseña y
# recordatorios de vencimiento). Si SMTP_HOST queda vacío, Mailer.php usa
# mail() nativo de PHP como fallback (funciona sin configurar nada extra
# en este hosting cPanel, que ya trae sendmail) -- configura estas
# variables solo si quieres enviar vía un proveedor SMTP real (Gmail
# workspace, SendGrid, Mailgun, el SMTP del propio cPanel, etc.).
# Prueba el handshake real con POST /api/v2/admin/test-email
# (super_admin) antes de dar esto por funcional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=CAMBIA_ESTA_CONTRASEÑA_POR_LA_REAL_DEL_PROVEEDOR_SMTP
SMTP_FROM_EMAIL=no-reply@fidepaz.org
SMTP_FROM_NAME=FidePaz
# none|tls|ssl -- tls (STARTTLS, típico puerto 587) es lo más común hoy;
# ssl es TLS implícito desde la conexión (típico puerto 465); none es solo
# para pruebas locales sin cifrado, nunca en producción.
SMTP_ENCRYPTION=tls
