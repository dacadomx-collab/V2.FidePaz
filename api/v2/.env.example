# Copiar a ".env" (NUNCA subir .env real a git ni al servidor sin permisos 600)
DB_HOST=localhost
DB_NAME=fidepaz_v2_db
DB_USER=fidepaz_v2_user
DB_PASS=CAMBIA_ESTA_CONTRASEÑA_POR_UNA_FUERTE
DB_CHARSET=utf8mb4

# Secreto HS256 para firmar JWT. Generar uno nuevo con:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_64_HEX_CHARS_ALEATORIOS
JWT_TTL_SECONDS=3600

# Orígenes permitidos por CORS, separados por coma. Nunca usar "*" con credenciales.
CORS_ALLOWED_ORIGINS=https://v2.fidepaz.org,http://localhost:4200

# APP_DEBUG=true expone mensaje/archivo/línea reales de excepciones en el JSON
# de error -- úsalo solo mientras diagnosticas y apágalo después.
APP_DEBUG=false
