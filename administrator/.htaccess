# INFORMATION
# For new versions of this Gist go to:
# https://gist.github.com/julianpoemp/bcf277cb56d2420cc53ec630a04a3566
# Version 1.3.0
#
# Contributors:
# - RaschidJFR [https://gist.github.com/RaschidJFR/f6d21a03b0692f5c7a6a23954003f00b]

# Notice:
# If you need redirection to https, uncomment the redirection part
# If you have issues with browser caching you can uncomment the BROWSER CACHING part

<IfModule mod_rewrite.c>
	RewriteEngine On

 	# -- Redirection to https (optional):
	# Please notice: You have to set your base-href attribute correctly:
	# a) If your app is on the root of the domain, you can just use "/"
	# b) If not, you need to set "https://" instead of "http://" in your base-href attribute
	# If you need this, uncomment the next two commands
	
	# RewriteCond %{HTTPS} !on
  	# RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}
    # Excluye localhost/127.0.0.1 (mismo criterio que el .htaccess raíz):
    # sin esta exclusión, XAMPP local (sin certificado SSL configurado)
    # redirige a https://localhost/... y la conexión falla -- eso es lo
    # que se percibía como "404" al probar /administrator/ en local
    # (2026-08-05).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# ---------------------------------------------------------------
	# Fase 9 (2026-08-10): desmantelamiento total del bundle Angular
	# heredado de V1 como punto de entrada. Ampliación de la Fase 8
	# (que solo redirigía la raíz exacta): ahora CUALQUIER ruta bajo
	# /administrator/ redirige a /panel/ -- ya no hay ninguna ruta
	# profunda (bookmarks tipo /administrator/home/quotas/index) que
	# siga sirviendo el bundle viejo. Mapeo específico primero (más
	# específico antes que más genérico, mod_rewrite usa el primer
	# match), catch-all al final para cualquier otra cosa bajo
	# /administrator/ -- incluidos los propios chunks compilados
	# (main.*.js, polyfills.*.js, etc.): con esto interceptados ANTES
	# de la regla de "servir archivo real" de más abajo, esos archivos
	# quedan físicamente en el servidor (este pipeline de FTP no borra
	# remotos, y forzar el borrado -- dangerous-clean-slate -- se evitó
	# a propósito: borraría también archivos reales no versionados que
	# SÍ deben seguir en el servidor, como .env) pero 100% inalcanzables
	# por HTTP -- cero bytes servidos, cero ejecución, purga funcional
	# equivalente a un borrado sin el riesgo de un borrado real.
	# Confirmado por auditoría (2026-08-10): "administrator/api/" NUNCA
	# fue una ruta real -- la API real vive en /api/v2/ (raíz del
	# dominio); lo que devolvía 200 ahí era el fallback SPA de Angular
	# disfrazando un 404 (Content-Type text/html, era el propio
	# index.html). La antigua regla de exención "RewriteCond
	# %{REQUEST_URI} ^/api/" tampoco funcionaba nunca -- REQUEST_URI
	# siempre incluye el prefijo completo /administrator/, jamás
	# empieza en /api/ -- se retira por ser código muerto que nunca
	# tuvo efecto real.
	RewriteCond %{REQUEST_URI} ^/administrator/home/owners/resume
	RewriteRule ^ /panel/mi-cuenta.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/quotas
	RewriteRule ^ /panel/cuotas.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/owners
	RewriteRule ^ /panel/propietarios.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/properties
	RewriteRule ^ /panel/propiedades.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/payments
	RewriteRule ^ /panel/pagos.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/reports
	RewriteRule ^ /panel/reportes.html [R=302,L]

	RewriteCond %{REQUEST_URI} ^/administrator/home/comunicados
	RewriteRule ^ /panel/comunicados.html [R=302,L]

	# Catch-all: cualquier otra ruta bajo /administrator/ (raíz, login,
	# chunks compilados, rutas no mapeadas arriba) -> pantalla de login
	# del panel nuevo.
	RewriteCond %{REQUEST_URI} ^/administrator/
	RewriteRule ^ /panel/login.html [R=302,L]

	RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
	RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
	RewriteRule ^.*$ - [NC,L]
	RewriteRule ^(.*) index.html [NC,L]

</IfModule>

#------------ BROWSER CACHING
# disable browser caching in production.
<FilesMatch "\.(html|htm|js|json|css)$">
	<IfModule mod_headers.c>
		FileETag None
		Header unset ETag
		Header unset Pragma
		Header unset Cache-Control
		Header unset Last-Modified
		Header set Pragma "no-cache"
		Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
		Header set Expires "Mon, 10 Apr 1972 00:00:00 GMT"
		Header set Access-Control-Allow-Origin "*"

	</IfModule>
</FilesMatch>
#------------
RewriteCond %{HTTP_HOST} ^administrator\.fidepaz\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.administrator\.fidepaz\.com$
RewriteRule ^/?$ "https\:\/\/administrator\.fidepaz\.org\/" [R=301,L]





